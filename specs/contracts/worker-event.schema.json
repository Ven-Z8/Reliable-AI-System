{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reliable-agent-platform.local/schemas/worker-event/1.0",
  "title": "WorkerEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "event_id",
    "timestamp",
    "event_type",
    "attempt",
    "payload",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "worker_started",
        "model_request",
        "model_response",
        "tool_requested",
        "tool_authorized",
        "tool_completed",
        "file_changed",
        "checkpoint",
        "retry",
        "warning",
        "worker_failed",
        "worker_completed"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
