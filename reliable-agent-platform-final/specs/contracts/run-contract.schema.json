{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reliable-agent-platform.local/schemas/run-contract/1.0",
  "title": "RunContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task",
    "repository",
    "worker",
    "allowed_paths",
    "denied_paths",
    "required_checks",
    "budgets",
    "approval_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "goal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "revision",
        "clean_required"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "clean_required": {
          "type": "boolean"
        }
      }
    },
    "worker": {
      "type": "string",
      "minLength": 1
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "denied_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "denied_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "timeout_seconds",
        "max_changed_files"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_changed_files": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "approval_policy": {
      "type": "string",
      "enum": [
        "auto",
        "ask",
        "deny"
      ]
    },
    "metadata": {
      "type": "object"
    }
  }
}
